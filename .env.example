# Client-side (VITE_ prefix — bundled into the browser build, must never hold secrets)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_GROQ_API_KEY=your-groq-api-key
VITE_ANCHOR_SECRET=

# Web Push VAPID public key — safe to expose client-side, it identifies the
# server (not a secret by itself). Generate a pair with:
#   npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# --- Server-side only (Vercel dashboard → Project → Settings → Environment
# Variables). NEVER prefix these with VITE_, never commit real values. ---

# The private half of the same VAPID key pair above. Only used server-side
# by api/send-push.ts to sign push messages.
VAPID_PRIVATE_KEY=

# Supabase service-role key (Project Settings → API → service_role). Lets
# api/send-push.ts read push_subscriptions for an arbitrary user_id — this
# is a server-to-server call with no end-user session, so it can't rely on
# a user JWT + RLS the way the rest of the app does.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret the caller must send in the `x-push-secret` header to invoke
# /api/send-push. Generate any long random string, e.g.:
#   openssl rand -hex 32
PUSH_SEND_SECRET=

# Groq API key used server-side by api/insights.ts AND api/cron/reminders.ts
# (VITE_GROQ_API_KEY above is a dev-only fallback the client calls directly —
# this one is the real key, never exposed to the browser).
GROQ_API_KEY=

# Set this and Vercel automatically sends `Authorization: Bearer <value>` on
# every Cron Job invocation — api/cron/reminders.ts checks it to make sure
# only Vercel's own scheduler (not a random caller) can trigger reminder
# sends. Generate any long random string, same way as PUSH_SEND_SECRET.
CRON_SECRET=
