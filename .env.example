# Client-side (VITE_ prefix — bundled into the browser build, must never hold secrets)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_GROQ_API_KEY=your-groq-api-key
VITE_ANCHOR_SECRET=

# Web Push VAPID public key — safe to expose client-side, it identifies the
# server (not a secret by itself). Generate a pair with:
#   npx web-push generate-vapid-keys
VITE_VAPID_PUBLIC_KEY=

# --- Server-side only (Vercel dashboard → Project → Settings → Environment
# Variables). NEVER prefix these with VITE_, never commit real values. ---

# The private half of the same VAPID key pair above. Only used server-side
# by api/send-push.ts to sign push messages.
VAPID_PRIVATE_KEY=

# Supabase service-role key (Project Settings → API → service_role). Lets
# api/send-push.ts read push_subscriptions for an arbitrary user_id — this
# is a server-to-server call with no end-user session, so it can't rely on
# a user JWT + RLS the way the rest of the app does. Also used by
# api/circle/notify-invite.ts and api/circle/send-invite-email.ts, which need
# to read one user's profile/invite row on behalf of another authenticated
# caller (each still verifies the caller's own JWT first — see those files).
# Also used by api/delete-account.ts, which needs it to call the Supabase
# Admin API (auth.admin.deleteUser) — no JWT scope lets a user delete their
# own auth.users row directly.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret the caller must send in the `x-push-secret` header to invoke
# /api/send-push. Generate any long random string, e.g.:
#   openssl rand -hex 32
PUSH_SEND_SECRET=

# Groq API key used server-side by api/insights.ts AND api/cron/reminders.ts
# (VITE_GROQ_API_KEY above is a dev-only fallback the client calls directly —
# this one is the real key, never exposed to the browser).
GROQ_API_KEY=

# Checked by api/cron/reminders.ts and api/cron/weekly-letter.ts to make
# sure only a legitimate scheduler (not a random caller) can trigger them.
# Vercel automatically sends `Authorization: Bearer <value>` on every native
# Cron Job invocation (still used for weekly-letter). reminders.ts is
# instead triggered every 15 minutes by a Supabase pg_cron job (see
# supabase/migrations/20260804170000_schedule_reminders_cron.sql) — this
# same value must also be stored under Supabase Vault as the
# 'anchor_cron_secret' secret (that migration's own comment has the exact
# command), never inlined in a committed SQL file. Generate any long random
# string, same way as PUSH_SEND_SECRET.
CRON_SECRET=

# SMTP2GO (https://www.smtp2go.com/) API key used by
# api/circle/send-invite-email.ts to send Circle of Trust invite emails to
# people who don't have an account yet. Create one under Settings → API Keys.
SMTP2GO_API_KEY=

# The "From" address for those emails — must be a verified sender/domain in
# your SMTP2GO account (Settings → Sender Domains / Verified Senders).
SMTP2GO_SENDER_EMAIL=

# Base URL used to build the invite link inside that email (e.g.
# https://anchor.app). Optional — falls back to `https://${VERCEL_URL}`
# (auto-set by every Vercel deployment) if left empty, so preview deploys
# work without configuring this.
APP_URL=
